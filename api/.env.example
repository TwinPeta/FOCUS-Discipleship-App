PORT=4000
NODE_ENV=development
# Public base URL used when building media URLs
BASE_URL=http://localhost:4000
# CHANGE THESE in any shared environment
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Set to false to start with an empty store (no demo data)
SEED_DEMO_DATA=true
# Comma-separated browser origins allowed by CORS (e.g. https://app.fcu.example,https://admin.fcu.example)
# Development: leave empty to allow any origin. Production: required for browser clients.
CORS_ORIGINS=
DATABASE_URL=
