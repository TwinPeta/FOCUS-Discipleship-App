{
  "name": "fcu-mobile-api",
  "version": "0.1.0",
  "description": "Express API for the FCU Student Community mobile app (see docs/api/openapi.yaml)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "prisma:schema": "node prisma/gen-schema.js",
    "prisma:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.19.3",
    "resend": "^6.38.1",
    "ws": "^8.18.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
