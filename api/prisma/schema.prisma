  ipAddress String?
  lastActiveAt DateTime? @db.Timestamptz(3)
  extra     Json?
  user User @relation("staffSessions_userId", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("staffSessions")
}

model Setting {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  key       String
  value     Json?
  extra     Json?

  @@unique([key])
  @@map("settings")
}
