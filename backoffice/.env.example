# Copy to .env.local and fill in.

# Public
NEXT_PUBLIC_APP_NAME="FCU Backoffice"
# "enabled" runs MSW mocks so you can build before the backend exists
NEXT_PUBLIC_API_MOCKING=enabled

# Server only
# Base URL of the Node.js backend (the proxy route forwards to this)
API_BASE_URL=http://localhost:4000
AUTH_ACCESS_COOKIE=fcu_access
AUTH_REFRESH_COOKIE=fcu_refresh

# Resumable video upload endpoint (tus or S3 multipart, to be agreed with the backend developer)
NEXT_PUBLIC_UPLOAD_ENDPOINT=

# Monitoring
SENTRY_DSN=
