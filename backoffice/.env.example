# Copy to .env.local and fill in.

# Public
NEXT_PUBLIC_APP_NAME="FCU Backoffice"

# Server only
# The API's address (the proxy forwards to <this>/v1/admin; the /v1/admin part is added if you leave it out)
API_BASE_URL=http://localhost:4000
AUTH_ACCESS_COOKIE=fcu_access
AUTH_REFRESH_COOKIE=fcu_refresh


# Monitoring
SENTRY_DSN=
